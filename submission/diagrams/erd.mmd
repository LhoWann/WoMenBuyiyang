erDiagram
    USER ||--o{ COURSE : "owns (lecturer)"
    USER ||--o{ COURSE_MEMBER : "joins as"
    COURSE ||--|{ COURSE_MEMBER : enrolls
    COURSE ||--o{ MEETING : schedules
    COURSE ||--o{ CONCEPT : covers
    MEETING ||--|{ SLIDE : contains
    MEETING ||--o{ QUESTION_GROUP : has
    SLIDE ||--o{ LIVE_QUESTION : receives
    QUESTION_GROUP ||--|{ LIVE_QUESTION : groups
    SLIDE ||--o{ LOST_SIGNAL : receives
    CONCEPT ||--o{ SLIDE : "taught in"
    MEETING ||--o{ CHECK_SET : "ends with"
    MEETING ||--o{ SUBMISSION : collects
    CHECK_SET ||--|{ CHECK_ITEM : contains
    SUBMISSION |o--o{ CHECK_ITEM : "source of"
    CONCEPT ||--o{ CHECK_ITEM : tests
    COURSE ||--o{ FREE_SLOT : offers
    FREE_SLOT ||--o{ TICKET : "booked as"
